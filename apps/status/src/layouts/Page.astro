---
import "@fontsource-variable/atkinson-hyperlegible-next";
import "virtual:galena/tokens.css";
import "../styles/page.css";
import { readSnapshot } from "../lib/snapshot.ts";

interface Props {
  title: string;
  description: string;
  pageName: string;
  /** On the live page only: the island applies nothing older than this snapshot. */
  snapshotVersion?: number;
  publishedAt?: string;
}
const { title, description, pageName, snapshotVersion, publishedAt } = Astro.props;
const { url: pageUrl, subscribe } = readSnapshot().page;
const feeds = [
  { id: "feed-rss", name: "RSS", url: new URL("/feed.rss", pageUrl).href },
  { id: "feed-atom", name: "Atom", url: new URL("/feed.atom", pageUrl).href },
];
---

<!doctype html>
<html lang="en" data-snapshot-version={snapshotVersion} data-published-at={publishedAt}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${pageName} status`} href="/feed.rss" />
    <link rel="alternate" type="application/atom+xml" title={`${pageName} status`} href="/feed.atom" />
  </head>
  <body>
    <main>
      <header class="brand">
        <a href="/">
          <svg class="mark" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16">
            <path
              fill-rule="evenodd"
              d="M1 1 L15 1 L15 15 L10 15 L10 14 L9 14 L9 13 L8 13 L8 12 L7 12 L7 11 L6 11 L6 10 L5 10 L5 9 L4 9 L4 8 L3 8 L3 7 L2 7 L2 6 L1 6 Z M1 9 L2 9 L2 10 L3 10 L3 11 L4 11 L4 12 L5 12 L5 13 L6 13 L6 14 L7 14 L7 15 L1 15 Z"
            ></path>
          </svg>{pageName} status
        </a>
        {subscribe && <a href="/#subscribe" class="subscribe-link" data-open="subscribe">Subscribe</a>}
      </header>
      <slot />
      <footer>
        <a href="#feeds" data-open="feeds">Feeds</a>
        <a href="https://galena.astrl.me/">Powered by Galena</a>
      </footer>
      <!-- Like the subscribe dialog: a dialog with JavaScript, a plain section at the end without. -->
      <dialog id="feeds" class="sheet" aria-labelledby="feeds-title">
        <div class="sheet-grip" data-grip aria-hidden="true"><span class="sheet-handle"></span></div>
        <div class="sheet-head">
          <h2 id="feeds-title">Follow in a feed reader</h2>
          <button type="button" class="sheet-close" data-close aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
          </button>
        </div>
        <p class="secondary">Incidents, newest first, from the last 14 days.</p>
        {feeds.map((feed) => (
          <div class="feed">
            <label for={feed.id}>{feed.name}</label>
            <div class="copy-row">
              <input id={feed.id} type="text" readonly value={feed.url} />
              <button type="button" data-copy={feed.id} data-name={feed.name}>Copy<span class="sr-only"> the {feed.name} address</span></button>
            </div>
          </div>
        ))}
        <p class="secondary" role="status" data-copied></p>
      </dialog>
    </main>
    <script>
      import "../scripts/sheet.ts";
      import "../scripts/feeds.ts";
    </script>
  </body>
</html>
