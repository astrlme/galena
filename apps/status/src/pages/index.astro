---
import {
  maintenanceStatusLabels,
  pageIndicatorLabels,
  pageIndicatorStates,
  type SnapshotComponent,
} from "@galena/contracts";
import Glyph from "../components/Glyph.astro";
import IncidentSummary from "../components/IncidentSummary.astro";
import PastIncident from "../components/PastIncident.astro";
import Strip from "../components/Strip.astro";
import Page from "../layouts/Page.astro";
import { utcDateTime, utcTime } from "../lib/format.ts";
import { rowLabel, rowState } from "../lib/row.ts";
import { readSnapshot } from "../lib/snapshot.ts";

const s = readSnapshot();
const headline = pageIndicatorLabels[s.indicator];
const grouped = new Set(s.groups.flatMap((g) => g.componentIds));
const ungrouped = s.components.filter((c) => !grouped.has(c.id));
const byId = new Map(s.components.map((c) => [c.id, c]));
const componentNames = (ids: string[]) =>
  ids
    .map((id) => byId.get(id as never)?.name)
    .filter(Boolean)
    .join(", ");
const groups = s.groups.map((g) => ({
  ...g,
  components: g.componentIds.flatMap((id) => byId.get(id) ?? []),
}));
const windows = [...s.maintenance.active, ...s.maintenance.upcoming];
// The latest few past incidents; the rest open in place.
const pastShown = s.incidents.recent.slice(0, 5);
const pastMore = s.incidents.recent.slice(5);
---

<Page title={`${s.page.name} status`} description={`${headline}. The current status of ${s.page.name}.`} pageName={s.page.name} snapshotVersion={s.snapshotVersion} publishedAt={s.publishedAt}>
  <div class="hero" data-live-hero>
    <h1 class="headline"><Glyph name={pageIndicatorStates[s.indicator]} class="" data-live-hero-glyph /><span data-live-headline>{headline}</span></h1>
    <p class="secondary" data-live-updated>Updated <time datetime={s.publishedAt}>{utcTime(s.publishedAt)}</time></p>
    <p class="notice" data-live-incidents data-ids={s.incidents.active.map((i) => i.id).join(",")} hidden></p>
    <p class="sr-only" aria-live="polite" data-live-announce></p>
  </div>

  {s.incidents.active.length > 0 && (
    <section aria-labelledby="active">
      <h2 id="active">Active incidents</h2>
      {s.incidents.active.map((incident) => <IncidentSummary incident={incident} card />)}
    </section>
  )}

  {windows.length > 0 && (
    <section aria-labelledby="maintenance">
      <h2 id="maintenance">Maintenance</h2>
      {windows.map((w) => (
        <article class="incident card impact-none">
          <h3 class="label"><Glyph name="under_maintenance" />{w.title}</h3>
          <p class="secondary">
            {maintenanceStatusLabels[w.status]}. <time datetime={w.startsAt}>{utcDateTime(w.startsAt)}</time> to <time datetime={w.endsAt}>{utcTime(w.endsAt)}</time>{w.componentIds.length > 0 && `. ${componentNames(w.componentIds)}`}.
          </p>
          <p>{w.body}</p>
        </article>
      ))}
    </section>
  )}

  <section aria-labelledby="components">
    <h2 id="components">Components</h2>
    {s.components.length === 0 && <p class="secondary">No components yet.</p>}
    {[{ id: "ungrouped", name: "", components: ungrouped }, ...groups].filter((g) => g.components.length > 0).map((group) => (
      <div class="group card">
        {group.name && <h3>{group.name}</h3>}
        {group.components.map((c: SnapshotComponent) => (
          <div class="component" data-component={c.id}>
            <div class="component-row">
              <span>{c.name}</span>
              <span class="state">
                <span class="label state-label"><Glyph name={rowState(c)} data-live-glyph /><span data-live-status>{rowLabel(c)}</span></span>
                <span class="num secondary">{c.uptime === null ? "No data" : `${c.uptime.toFixed(2)}%`}</span>
              </span>
            </div>
            <Strip name={c.name} componentId={c.id} days={c.days} incidents={[...s.incidents.active, ...s.incidents.recent]} now={s.publishedAt} />
          </div>
        ))}
      </div>
    ))}
  </section>

  <section aria-labelledby="past">
    <h2 id="past">Past incidents</h2>
    {s.incidents.recent.length === 0 ? (
      <p class="secondary">No incidents in the last 14 days.</p>
    ) : (
      <>
        <ol class="past">
          {pastShown.map((i) => <PastIncident incident={i} />)}
        </ol>
        {pastMore.length > 0 && (
          <details class="more">
            <summary>Show {pastMore.length} more</summary>
            <ol class="past">
              {pastMore.map((i) => <PastIncident incident={i} />)}
            </ol>
          </details>
        )}
      </>
    )}
  </section>

  <!-- A dialog (a bottom sheet on phones) with JavaScript; without it, a plain section here. -->
  <dialog id="subscribe" class="sheet" aria-labelledby="subscribe-title">
    <div class="sheet-grip" data-grip aria-hidden="true"><span class="sheet-handle"></span></div>
    <div class="sheet-head">
      <h2 id="subscribe-title">Get updates by email</h2>
      <button type="button" class="sheet-close" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
      </button>
    </div>
    <form class="subscribe" method="post" action="/public/subscribe" data-subscribe>
      <label for="subscribe-email">Email address</label>
      <div class="subscribe-row">
        <input id="subscribe-email" name="email" type="email" autocomplete="email" required />
        <button type="submit">Subscribe</button>
      </div>
      {s.components.length > 1 && (
        <details>
          <summary>Only some components</summary>
          <fieldset>
            <legend class="sr-only">Components to hear about</legend>
            {s.components.map((c) => (
              <label class="choice"><input type="checkbox" name="component" value={c.id} />{c.name}</label>
            ))}
          </fieldset>
        </details>
      )}
      <p class="secondary" data-subscribe-status role="status">We'll email a link to confirm. Every email has a one-click unsubscribe.</p>
    </form>
  </dialog>
</Page>

<script>
  import "../scripts/live.ts";
  import "../scripts/strip.ts";
  import "../scripts/subscribe.ts";
</script>
