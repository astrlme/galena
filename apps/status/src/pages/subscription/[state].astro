---
import type { GetStaticPaths } from "astro";
import Page from "../../layouts/Page.astro";
import { readSnapshot } from "../../lib/snapshot.ts";
import { type SubscriptionState, subscriptionPages } from "../../lib/subscription.ts";

export const getStaticPaths = (() =>
  Object.keys(subscriptionPages).map((state) => ({ params: { state } }))) satisfies GetStaticPaths;

const state = Astro.params.state as SubscriptionState;
const { title, text } = subscriptionPages[state];
const s = readSnapshot();
// The two pages a link from an email opens: a button does the work, not the link.
const forms: Partial<Record<SubscriptionState, { ask: string; button: string; noscript: string }>> =
  {
    confirm: {
      ask: `Get an email from ${s.page.name} status when an incident or maintenance is posted?`,
      button: "Confirm subscription",
      noscript: "This page needs JavaScript to read your link.",
    },
    unsubscribe: {
      ask: `Stop email from ${s.page.name} status?`,
      button: "Unsubscribe",
      noscript:
        "This page needs JavaScript to read your link. The Unsubscribe button in your mail app works without it.",
    },
  };
const form = forms[state];
---

<Page title={`${title}: ${s.page.name} status`} description={title} pageName={s.page.name}>
  <h1 class="headline hero">{title}</h1>
  {form ? (
    <>
      <p>{form.ask}</p>
      <form class="subscribe" method="post" action={`/public/${state}`} data-link-form>
        <input type="hidden" name="t" />
        <button type="submit">{form.button}</button>
      </form>
      <noscript><p class="secondary">{form.noscript}</p></noscript>
    </>
  ) : (
    <p>{text}</p>
  )}
</Page>

<script>
  // The token is in the link from the email; the form posts it, so opening the page (or a mail
  // scanner following the link) confirms or unsubscribes nobody.
  const input = document.querySelector<HTMLInputElement>("[data-link-form] input[name=t]");
  if (input) input.value = new URLSearchParams(location.search).get("t") ?? "";
</script>
