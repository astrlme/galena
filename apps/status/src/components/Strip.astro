---
import type { SnapshotDay } from "@galena/contracts";
import { utcDay } from "../lib/format.ts";
import { describeDay, ROW, stripPaths, stripWidth } from "../lib/strip.ts";

interface Props {
  name: string;
  days: SnapshotDay[];
}
const { name, days } = Astro.props;
const width = stripWidth(days.length);
// Days worth reading out; the caption says every other day was operational.
const notable = days.filter((d) => d.worst !== null && d.worst !== "operational");
---

<div class="strip">
  <svg width={width} height={ROW} viewBox={`0 0 ${width} ${ROW}`} role="img" aria-label={`${name}: the last ${days.length} days`}>
    <rect class="baseline" x="0" y={ROW - 1} width={width} height="1"></rect>
    {stripPaths(days).map((p) => <path class={p.className} d={p.d}></path>)}
  </svg>
</div>
<div class="captions" aria-hidden="true">
  <span><span class="days-90">90 days ago</span><span class="days-60">60 days ago</span><span class="days-30">30 days ago</span></span>
  <span>Today</span>
</div>
<div class="sr-only">
  <table>
    <caption>{name}: days in the last {days.length} that were not fully operational. Every other day was operational or has no data.</caption>
    <thead><tr><th scope="col">Day</th><th scope="col">State</th></tr></thead>
    <tbody>
      {notable.map((d) => <tr><td>{utcDay(`${d.date}T00:00:00.000Z`)}</td><td>{describeDay(d)}</td></tr>)}
    </tbody>
  </table>
</div>
