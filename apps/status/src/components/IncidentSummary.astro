---
import {
  incidentImpactLabels,
  incidentStatusLabels,
  pageIndicatorStates,
  type SnapshotIncident,
} from "@galena/contracts";
import { utcDateTime } from "../lib/format.ts";
import Glyph from "./Glyph.astro";

interface Props {
  incident: SnapshotIncident;
  /** On its own card, as on the front page. */
  card?: boolean;
}
const { incident, card = false } = Astro.props;
// The latest few updates, each cut to a sentence or so; the incident page has the rest.
const SHOWN = 3;
const shown = incident.updates.slice(0, SHOWN);
const earlier = incident.updates.length - shown.length;
const preview = (body: string) => (body.length > 160 ? `${body.slice(0, 157).trimEnd()}…` : body);
---

<article class:list={["incident", `impact-${incident.impact}`, { card }]}>
  <div class="incident-title">
    <span class="label">
      {incident.impact !== "none" && <Glyph name={pageIndicatorStates[incident.impact]} />}
      <a href={`/incidents/${incident.id}/`}>{incident.title}</a>
    </span>
    {incident.impact !== "none" && <span class="secondary">{incidentImpactLabels[incident.impact]}</span>}
  </div>
  {shown.length > 0 && (
    <ol class="timeline compact">
      {shown.map((u) => (
        <li>
          <p><strong>{incidentStatusLabels[u.status]}</strong> <span class="secondary"><time datetime={u.createdAt}>{utcDateTime(u.createdAt)}</time></span></p>
          <p>{preview(u.body)}</p>
        </li>
      ))}
    </ol>
  )}
  {earlier > 0 && (
    <p class="secondary"><a href={`/incidents/${incident.id}/`}>{earlier} earlier {earlier === 1 ? "update" : "updates"}</a></p>
  )}
</article>
