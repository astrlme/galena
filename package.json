{
  "name": "galena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "echo pnpm dev is not set up yet && exit 1",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:deps",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --passWithNoTests",
    "test:int": "echo no integration tests yet",
    "test:e2e": "echo test:e2e is not set up yet && exit 1",
    "trigger:dev": "pnpm --filter @galena/workers dev",
    "replay": "echo replay is not set up yet && exit 1",
    "check:deps": "depcruise apps packages scripts infra --config .dependency-cruiser.cjs",
    "db:generate": "echo db:generate is not set up yet && exit 1",
    "db:migrate": "echo db:migrate is not set up yet && exit 1",
    "infra:synth": "pnpm --filter @galena/infra synth",
    "infra:diff": "pnpm --filter @galena/infra diff",
    "deploy:dev": "pnpm --filter @galena/infra deploy:dev",
    "deploy:prod": "pnpm --filter @galena/infra deploy:prod"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "dependency-cruiser": "^18.4.0",
    "turbo": "^2.11.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
