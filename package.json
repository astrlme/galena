{
  "name": "galena",
  "private": true,
  "description": "An open-source status page you deploy into your own AWS account.",
  "license": "Apache-2.0",
  "homepage": "https://galena.astrl.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrlme/galena.git"
  },
  "bugs": "https://github.com/astrlme/galena/issues",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up -d --wait && pnpm db:migrate && pnpm db:seed && turbo run dev dev:hot-path",
    "dev:hot-path": "node scripts/dev-hot-path.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:deps",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:e2e": "docker compose up -d --wait && pnpm db:migrate && pnpm db:seed && pnpm --filter @galena/web e2e",
    "trigger:dev": "pnpm --filter @galena/workers trigger:dev",
    "replay": "vitest run packages/core/src/detection/replay.test.ts",
    "check:page": "pnpm --filter @galena/status check:page",
    "check:deps": "depcruise apps packages scripts infra --config .dependency-cruiser.cjs",
    "db:generate": "pnpm --filter @galena/db generate",
    "db:migrate": "pnpm --filter @galena/db migrate",
    "infra:synth": "pnpm --filter @galena/infra synth",
    "infra:diff": "pnpm --filter @galena/infra diff",
    "deploy:dev": "pnpm --filter @galena/infra deploy:dev",
    "deploy:prod": "pnpm --filter @galena/infra deploy:prod",
    "db:seed": "pnpm --filter @galena/api seed",
    "api:generate": "pnpm --filter @galena/api openapi && pnpm --filter @galena/web generate:api"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1141.0",
    "@aws-sdk/lib-dynamodb": "^3.1141.0",
    "@biomejs/biome": "^2.5.14",
    "@galena/contracts": "workspace:*",
    "@galena/core": "workspace:*",
    "@galena/db": "workspace:*",
    "@galena/integrations": "workspace:*",
    "@types/node": "^24.13.6",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "^0.28.2",
    "turbo": "^2.11.3",
    "typescript": "6.0.3",
    "uuid": "^14.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
