{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!packages/db/migrations",
      "!apps/api/openapi.json",
      "!apps/web/src/lib/api-schema.ts",
      "!packages/publisher/test/golden",
      "!packages/emails/test/golden",
      "!packages/integrations/test/golden"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noDefaultExport": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.config.*"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/tokens.css"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["packages/core/src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "process": "packages/core is pure: take it through a port in src/ports.ts",
                  "fetch": "packages/core is pure: take it through a port in src/ports.ts",
                  "setTimeout": "packages/core is pure: take it through a port in src/ports.ts",
                  "setInterval": "packages/core is pure: take it through a port in src/ports.ts",
                  "crypto": "packages/core is pure: take it through a port in src/ports.ts",
                  "performance": "packages/core is pure: take it through a port in src/ports.ts"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/app/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
